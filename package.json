{
  "name": "agentskills-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.14.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm build && tsc -p tsconfig.tests.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && vitest run",
    "validate:skills": "node packages/cli/dist/index.js validate skills",
    "agentskills": "node packages/cli/dist/index.js",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && vitest run && pnpm validate:skills"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.0.1",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.46.3",
    "vitest": "^5.0.4"
  }
}
